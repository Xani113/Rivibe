# Optional Music API Keys from https://github.com/public-apis/public-apis#music
# RiVibe works out-of-the-box without any keys using keyless CORS APIs
# (iTunes Search, Audius, ListenBrainz, Radio Browser, Lyrics.ovh, TheAudioDB test key).
# Add your own keys below or directly inside the app's API Vault (Settings).

# Last.fm API Key (https://www.last.fm/api) — enhances Spotify-like track & artist similarity
VITE_LASTFM_API_KEY=

# TasteDive API Key (https://tastedive.com/read/api) — cross-artist recommendation graph
VITE_TASTEDIVE_API_KEY=

# Jamendo Client ID (https://developer.jamendo.com/v3.0/docs) — full-length Creative Commons streams
VITE_JAMENDO_CLIENT_ID=

# TheAudioDB API Key (https://www.theaudiodb.com/) — defaults to public test key "123"
VITE_THEAUDIODB_API_KEY=123

# Genius Access Token (https://docs.genius.com/) — optional song context metadata
VITE_GENIUS_ACCESS_TOKEN=

# Spotify Client ID (https://developer.spotify.com/) — optional external catalog bridge
VITE_SPOTIFY_CLIENT_ID=

# Optional GitHub Releases URL for in-app Android APK download button
VITE_GITHUB_REPO_URL=https://github.com/xani13/rivibe
