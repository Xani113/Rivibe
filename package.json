{
  "name": "rivibe",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "RiVibe — Spatial glass music streaming, live radio & Spotify-style discovery PWA and Android mobile app",
  "scripts": {
    "dev": "concurrently -n WEB,API -c yellow,cyan \"vite --host\" \"npm --prefix backend run dev\"",
    "dev:web": "vite --host",
    "dev:api": "npm --prefix backend run dev",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm --prefix backend run build",
    "preview": "vite preview --host",
    "test": "vitest run && npm --prefix backend test",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit && npm --prefix backend run typecheck",
    "lint": "eslint src",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "lucide-react": "^1.82.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.10.3",
    "concurrently": "^10.0.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
