# Next.js Backend Environment (.env.local - NEVER commit real secrets)
JWT_SECRET=replace-with-a-32-char-random-secret-in-production
DATABASE_PATH=./data/rivibe.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost

# Official Google Cloud YouTube Data API v3 Key (for full-length music catalog search & playback)
# Create one in Google Cloud Console -> APIs & Services -> YouTube Data API v3
YOUTUBE_API_KEY=

# Optional public-apis#music server-side keys (kept hidden from browsers)
LASTFM_API_KEY=
TASTEDIVE_API_KEY=
JAMENDO_CLIENT_ID=
THEAUDIODB_API_KEY=123
